; Engine configuration file.
; Farroad Godot port. Milestone 1 (the combat engine, FarroadCore.gd) runs
; headless via `godot --headless --script res://test/parity_test.gd`, the
; same command-line automation Godot ships for CI, mirroring how
; `node farroadsmoke.js` runs for the JS side of this project.
; Milestone 2 (UI/sprites) added a real main scene showing one hardcoded
; demo battle. Milestone 3 (the game loop) replaces it with Game.tscn --
; GameController.gd owns real game state and drives BattlePresenter wave
; after wave, so opening the project normally (no --headless) now plays an
; actual continuing, persistent game rather than one fixed fight.

config_version=5

[application]

config/name="Farroad"
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/Game.tscn"

[gui]

; A project-wide DEFAULT theme, not a runtime `root.theme` assignment --
; confirmed via a real headless test that GameController extends Node2D
; (not Control/Window), and a Theme set at runtime on the root Window does
; NOT propagate down through that Node2D gap into the PopupPanels every
; tab window uses (a real, confirmed Godot behavior, not a guess). The
; project's own default theme, by contrast, is a global fallback every
; Control/Window resolves against independently, so it reaches every
; button in every popup regardless of the Node2D ancestor. See
; theme/default_theme.tres and Ian's "make buttons more visible distinct
; from their backgrounds" ask.
theme/custom="res://theme/default_theme.tres"

[display]

; 360x800 is the DESIGN resolution, not a fixed output size -- meant to run
; on phones, which come in wildly different aspect ratios. stretch/mode
; canvas_items keeps 2D crisp while scaling; aspect=expand means a device
; whose aspect ratio differs from this gets MORE visible content on the
; wider/taller axis rather than letterboxing, so get_viewport_rect().size
; (what BattlePresenter.gd's layout is computed from, as fractions -- never
; a fixed pixel constant) reflects the real per-device canvas, not always
; exactly 360x800.
; 412x915 (~1:2.22, portrait) -- Ian's call: default to a real device, the
; Google Pixel 7 (1080x2400 physical px at a ~2.625x device pixel ratio,
; i.e. 412x915 logical px -- the same figure Chrome DevTools' own "Pixel 7"
; device preset uses). Same aspect ratio as the prior 360x800 placeholder
; phone size, just the real Pixel 7 figure instead of a round number.
window/size/viewport_width=412
window/size/viewport_height=915
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; handheld/orientation is an enum project setting (int index into
; landscape/portrait/reverse_landscape/reverse_portrait/sensor_landscape/
; sensor_portrait/sensor) -- 1 = portrait. A quoted string like "portrait"
; silently fails to parse and falls back to the default (0 = landscape),
; which is exactly why the first Android build shipped landscape-only
; despite this line already being present with the wrong value type.
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true
